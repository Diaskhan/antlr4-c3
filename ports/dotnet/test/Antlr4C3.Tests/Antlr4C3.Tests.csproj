<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<IsPackable>false</IsPackable>
	<Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
	<PackageReference Include="xunit" Version="2.9.2" />
	<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\src\Antlr4C3\Antlr4C3.csproj" />
  </ItemGroup>

  <ItemGroup>
	<!-- Reuse the SQLite parser generated for the demo project -->
	<Compile Include="..\..\app\Antlr4C3.Demo\Grammar\SQLiteLexer.cs" Link="Grammar\SQLiteLexer.cs" />
	<Compile Include="..\..\app\Antlr4C3.Demo\Grammar\SQLiteParser.cs" Link="Grammar\SQLiteParser.cs" />
	<Compile Include="..\..\app\Antlr4C3.Demo\Grammar\SQLiteParserListener.cs" Link="Grammar\SQLiteParserListener.cs" />
	<Compile Include="..\..\app\Antlr4C3.Demo\Grammar\SQLiteParserBaseListener.cs" Link="Grammar\SQLiteParserBaseListener.cs" />
  </ItemGroup>

  <ItemGroup>
	<None Update="Parser.cpp">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>
